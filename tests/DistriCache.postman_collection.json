{
  "info": {
    "name": "DistriCache - Gateway, Rate Limiter & Semantic LLM Cache",
    "_postman_id": "districache-portfolio-collection-v3",
    "description": "Production integration suite for DistriCache API Gateway, Atomic Sliding-Window Rate Limiter, Circuit Breakers, and FAISS Semantic LLM Cache.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "semantic_cache_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "mock_service_url", "value": "http://localhost:8001", "type": "string" },
    { "key": "api_key_pro", "value": "dc_live_testkey_123456789", "type": "string" },
    { "key": "api_key_free", "value": "dc_free_demo_key", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Gateway & Dynamic Route Management",
      "item": [
        {
          "name": "1.1 Gateway Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 UP', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/health"
          }
        },
        {
          "name": "1.2 Get Registered Routes from DB",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns active routes list', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.routes).to.be.an('array');",
                  "    pm.expect(json.routes.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/admin/routes"
          }
        },
        {
          "name": "1.3 Trigger Zero-Downtime Route Reload",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Routes reloaded successfully', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.count).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{gateway_url}}/admin/routes/reload"
          }
        },
        {
          "name": "1.4 Get Real-Time Gateway Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Metrics aggregated successfully', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('totalRequests');",
                  "    pm.expect(json).to.have.property('circuitBreakers');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/admin/metrics"
          }
        }
      ]
    },
    {
      "name": "2. Authentication & Atomic Rate Limiter",
      "item": [
        {
          "name": "2.1 Authorized Request (Pro Tier)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Accepts valid API key', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.has('X-RateLimit-Limit')).to.be.true;",
                  "    pm.expect(pm.response.headers.has('X-RateLimit-Remaining')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key_pro}}" }
            ],
            "url": "{{gateway_url}}/api/v1/mock/products"
          }
        },
        {
          "name": "2.2 Unauthorized Request (Missing Key -> 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects request without key with 401', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/v1/mock/products"
          }
        },
        {
          "name": "2.3 Rate Limit Flood (Free Tier -> 429 Too Many Requests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns rate-limiting headers or 429 throttle', function() {",
                  "    pm.expect([200, 429]).to.include(pm.response.code);",
                  "    if (pm.response.code === 429) {",
                  "        pm.expect(pm.response.headers.has('Retry-After')).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key_free}}" }
            ],
            "url": "{{gateway_url}}/api/v1/mock/products"
          }
        }
      ]
    },
    {
      "name": "3. Semantic LLM Query Cache Engine",
      "item": [
        {
          "name": "3.1 Cold Query (Cache MISS ~800ms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cold query is Cache MISS', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key_pro}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"How does distributed rate limiting work with Redis?\"\n}"
            },
            "url": "{{gateway_url}}/api/v1/llm/query"
          }
        },
        {
          "name": "3.2 Exact Warm Query (Cache HIT sub-10ms)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Identical query is Cache HIT', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT');",
                  "    var latency = parseFloat(pm.response.headers.get('X-Cache-Latency-Ms') || '100');",
                  "    pm.expect(latency).to.be.below(15.0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key_pro}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"How does distributed rate limiting work with Redis?\"\n}"
            },
            "url": "{{gateway_url}}/api/v1/llm/query"
          }
        },
        {
          "name": "3.3 Semantically Similar Query (Cache HIT >= 0.95)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Paraphrase triggers Semantic Cache HIT', function() {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT');",
                  "    var similarity = parseFloat(pm.response.headers.get('X-Cache-Similarity') || '0');",
                  "    pm.expect(similarity).to.be.at.least(0.95);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key_pro}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"How does Redis handle distributed rate limiting?\"\n}"
            },
            "url": "{{gateway_url}}/api/v1/llm/query"
          }
        }
      ]
    },
    {
      "name": "4. Circuit Breaker Resilience & Fault Injection",
      "item": [
        {
          "name": "4.1 Inject Downstream Outage (100% 500s)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Downstream outage injected', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fail_on_demand\": true,\n  \"latency_ms\": 50\n}"
            },
            "url": "{{mock_service_url}}/mock/config"
          }
        },
        {
          "name": "4.2 Trigger Failures & Observe Circuit Breaker Trip (HTTP 503)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Fast-fails with 503 or 502', function() {",
                  "    pm.expect([502, 503]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key_pro}}" }
            ],
            "url": "{{gateway_url}}/api/v1/mock/products"
          }
        },
        {
          "name": "4.3 Restore Downstream Target Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Downstream target restored', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fail_on_demand\": false,\n  \"latency_ms\": 800\n}"
            },
            "url": "{{mock_service_url}}/mock/config"
          }
        }
      ]
    },
    {
      "name": "5. Async Vector Eviction & Cache Management",
      "item": [
        {
          "name": "5.1 List All Active Vector Entries",
          "request": {
            "method": "GET",
            "url": "{{semantic_cache_url}}/cache/entries"
          }
        },
        {
          "name": "5.2 Invalidate Vectors by Pattern",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pattern\": \"*Redis*\"\n}"
            },
            "url": "{{semantic_cache_url}}/cache/invalidate/pattern"
          }
        },
        {
          "name": "5.3 Invalidate Vectors by Age",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"max_age_seconds\": 3600\n}"
            },
            "url": "{{semantic_cache_url}}/cache/invalidate/age"
          }
        }
      ]
    }
  ]
}
