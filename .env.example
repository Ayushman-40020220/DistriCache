# =============================================================================
# DistriCache Environment Configuration
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=districache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/districache

# Redis
REDIS_URL=redis://localhost:6379

# Gateway
PORT=8080
NODE_ENV=development
GATEWAY_INSTANCE_ID=gateway-node-1
DEFAULT_RATELIMIT_MAX=60
DEFAULT_RATELIMIT_WINDOW_SEC=60
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_MS=15000
HEALTH_CHECK_INTERVAL_MS=10000
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_BATCH_SIZE=100

# Semantic Cache
SEMANTIC_CACHE_PORT=8000
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=86400
INDEX_STORAGE_PATH=/data/faiss_index.bin
METADATA_STORAGE_PATH=/data/faiss_metadata.json
DOWNSTREAM_LLM_URL=http://mock-service:8001/v1/chat/completions
